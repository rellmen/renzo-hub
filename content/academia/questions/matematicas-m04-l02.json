      "prompt_md": "¿Cuál es el recorrido de $f(x)=\\sqrt{x}+2$?",
      "choices": [{"id": "a", "text": "$[0,+\\infty)$"}, {"id": "b", "text": "$[2,+\\infty)$"}, {"id": "c", "text": "$\\mathbb R$"}, {"id": "d", "text": "$(2,+\\infty)$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "$\\sqrt x\\ge0$, así que $\\sqrt x+2\\ge2$, y el 2 se alcanza en $x=0$."
