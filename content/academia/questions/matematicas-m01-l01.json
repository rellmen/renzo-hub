{
  "lesson_id": "matematicas-m01-l01",
  "questions": [
    {
      "id": "m01l01-x1", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["distributive"],
      "prompt_md": "¿Cuál es el desarrollo correcto de $-2(x-4)$?",
      "choices": [{"id": "a", "text": "$-2x-8$"}, {"id": "b", "text": "$-2x+8$"}, {"id": "c", "text": "$-2x-4$"}, {"id": "d", "text": "$2x+8$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "$-2\\cdot x=-2x$ y $-2\\cdot(-4)=+8$."
    },
    {
      "id": "m01l01-x2", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["like_terms"],
      "prompt_md": "Reduce $4x^2+3x-x^2-5x$.",
      "choices": [{"id": "a", "text": "$3x^2-2x$"}, {"id": "b", "text": "$x^2$"}, {"id": "c", "text": "$5x^2-2x$"}, {"id": "d", "text": "$3x^2+8x$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "$4x^2-x^2=3x^2$ y $3x-5x=-2x$. $x^2$ y $x$ no son semejantes."
    },
    {
      "id": "m01l01-x3", "kind": "numeric", "difficulty": 2, "skill_ids": ["algebraic_language"],
      "prompt_md": "Calcula el valor de $3x^2-2x+5$ cuando $x=-2$.",
      "hint_md": "Sustituye entre paréntesis: $3(-2)^2-2(-2)+5$.",
      "key": {"value": 21, "tolerance": 0},
      "explanation_md": "$3\\cdot4+4+5=21$."
    },
    {
      "id": "m01l01-x4", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["distributive", "like_terms"],
      "prompt_md": "Simplifica $5(a-1)-(2a-7)$.",
      "choices": [{"id": "a", "text": "$3a-12$"}, {"id": "b", "text": "$3a+2$"}, {"id": "c", "text": "$3a-2$"}, {"id": "d", "text": "$7a+2$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "$5a-5-2a+7=3a+2$."
    },
    {
      "id": "m01l01-x5", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["algebraic_language"],
      "prompt_md": "«El cuadrado de la diferencia entre un número y 3» se escribe:",
      "choices": [{"id": "a", "text": "$x^2-3$"}, {"id": "b", "text": "$x^2-3^2$"}, {"id": "c", "text": "$(x-3)^2$"}, {"id": "d", "text": "$x-3^2$"}],
      "key": {"correct_choice_id": "c"},
      "explanation_md": "Primero la diferencia $x-3$ y después se eleva toda al cuadrado."
    }
  ]
}
