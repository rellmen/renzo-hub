{
  "lesson_id": "matematicas-m02-l01",
  "questions": [
    {
      "id": "m02l01-x1", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["notable_identities"],
      "prompt_md": "Desarrolla $(x-6)^2$.",
      "choices": [{"id": "a", "text": "$x^2-36$"}, {"id": "b", "text": "$x^2+36$"}, {"id": "c", "text": "$x^2-12x+36$"}, {"id": "d", "text": "$x^2-6x+36$"}],
      "key": {"correct_choice_id": "c"},
      "explanation_md": "$x^2-2\\cdot x\\cdot6+6^2=x^2-12x+36$."
    },
    {
      "id": "m02l01-x2", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["factoring"],
      "prompt_md": "Factoriza $25x^2-1$.",
      "choices": [{"id": "a", "text": "$(5x-1)^2$"}, {"id": "b", "text": "$(5x+1)(5x-1)$"}, {"id": "c", "text": "$25(x+1)(x-1)$"}, {"id": "d", "text": "No se puede factorizar"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "Diferencia de cuadrados: $(5x)^2-1^2=(5x+1)(5x-1)$."
    },
    {
      "id": "m02l01-x3", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["factoring", "notable_identities"],
      "prompt_md": "¿Cuál de estos polinomios es un trinomio cuadrado perfecto?",
      "choices": [{"id": "a", "text": "$x^2+6x+9$"}, {"id": "b", "text": "$x^2+3x+9$"}, {"id": "c", "text": "$x^2+9$"}, {"id": "d", "text": "$x^2-6x-9$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "$x^2+6x+9=(x+3)^2$ porque $2\\cdot x\\cdot3=6x$. En (d) el término independiente es negativo y no puede ser un cuadrado."
    },
    {
      "id": "m02l01-x4", "kind": "numeric", "difficulty": 2, "skill_ids": ["notable_identities"],
      "prompt_md": "Calcula mentalmente $102\\cdot98$ usando la suma por diferencia.",
      "hint_md": "$102\\cdot98=(100+2)(100-2)$.",
      "key": {"value": 9996, "tolerance": 0},
      "explanation_md": "$100^2-2^2=10000-4=9996$."
    },
    {
      "id": "m02l01-x5", "kind": "multiple_choice", "difficulty": 3, "skill_ids": ["factoring"],
      "prompt_md": "Factoriza completamente $2x^3-8x^2+8x$.",
      "choices": [{"id": "a", "text": "$2x(x-2)^2$"}, {"id": "b", "text": "$2x(x+2)(x-2)$"}, {"id": "c", "text": "$2(x-2)^2$"}, {"id": "d", "text": "$x(2x-4)^2$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "$2x(x^2-4x+4)=2x(x-2)^2$. La opción (d) desarrollada da $4x^3-16x^2+16x$, el doble."
    }
  ]
}
