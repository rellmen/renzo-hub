  "questions": [
    {
      "id": "m09l01-x1", "kind": "numeric", "difficulty": 1, "skill_ids": ["definite_integral"],
      "prompt_md": "Calcula $\\displaystyle\\int_1^3 2x\\,dx$.",
      "key": {"value": 8, "tolerance": 0},
      "explanation_md": "$\\big[x^2\\big]_1^3=9-1=8$."
    },
    {
      "id": "m09l01-x2", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["antiderivatives"],
      "prompt_md": "¿Cuál es una primitiva de $f(x)=\\dfrac{3}{x}+e^{2x}$?",
      "choices": [{"id": "a", "text": "$3\\ln|x|+\\tfrac12e^{2x}$"}, {"id": "b", "text": "$-\\tfrac{3}{x^2}+2e^{2x}$"}, {"id": "c", "text": "$3\\ln|x|+e^{2x}$"}, {"id": "d", "text": "$\\tfrac{3x^2}{2}+\\tfrac12e^{2x}$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "$\\int\\frac3x=3\\ln|x|$; $\\int e^{2x}=\\frac12e^{2x}$. La opción b es la derivada."
    },
    {
      "id": "m09l01-x3", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["integration_methods"],
      "prompt_md": "¿Cuál es $\\int x\\,e^{x}\\,dx$?",
      "choices": [{"id": "a", "text": "$\\tfrac{x^2}{2}e^x+C$"}, {"id": "b", "text": "$e^x(x-1)+C$"}, {"id": "c", "text": "$e^x(x+1)+C$"}, {"id": "d", "text": "$xe^x+C$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "Por partes: $xe^x-\\int e^x=e^x(x-1)+C$."
    },
    {
      "id": "m09l01-x4", "kind": "numeric", "difficulty": 3, "skill_ids": ["area_between_curves"],
      "prompt_md": "Calcula el área del recinto limitado por $f(x)=9-x^2$ y el eje OX.", "unit": "u²",
      "key": {"value": 36, "tolerance": 0.01},
      "explanation_md": "Cortes $\\pm3$: $\\left[9x-\\frac{x^3}{3}\\right]_{-3}^{3}=18-(-18)=36$."
    },
    {
      "id": "m09l01-x5", "kind": "numeric", "difficulty": 3, "skill_ids": ["area_between_curves"],
      "prompt_md": "Calcula el área encerrada entre $f(x)=x^2$ y $g(x)=2x$. Da el resultado con 2 decimales.", "unit": "u²",
      "key": {"value": 1.3333, "tolerance": 0.01},
      "explanation_md": "Cortes en 0 y 2; $\\int_0^2(2x-x^2)dx=\\left[x^2-\\frac{x^3}{3}\\right]_0^2=4-\\frac83=\\frac43\\approx1{,}33$."
    }
  ]
