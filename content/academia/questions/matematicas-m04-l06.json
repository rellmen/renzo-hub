      "id": "m04l06-x1", "kind": "numeric", "difficulty": 1, "skill_ids": ["logarithms"],
      "prompt_md": "Calcula $\\log_2 64$.",
      "key": {"value": 6, "tolerance": 0},
      "explanation_md": "$2^6=64$."
    },
    {
      "id": "m04l06-x2", "kind": "numeric", "difficulty": 1, "skill_ids": ["exp_log_equations"],
      "prompt_md": "Resuelve $2^{x-1}=16$.",
      "key": {"value": 5, "tolerance": 0},
      "explanation_md": "$16=2^4$ → $x-1=4$ → $x=5$."
    },
    {
      "id": "m04l06-x3", "kind": "numeric", "difficulty": 2, "skill_ids": ["exp_log_equations"],
      "prompt_md": "Resuelve $\\log x=2$ (logaritmo decimal).",
      "key": {"value": 100, "tolerance": 0},
      "explanation_md": "$x=10^2=100$."
    },
    {
      "id": "m04l06-x4", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["logarithms"],
      "prompt_md": "¿Cuál de estas igualdades es **correcta** (con $a,b>0$)?",
      "choices": [{"id": "a", "text": "$\\log(a+b)=\\log a+\\log b$"}, {"id": "b", "text": "$\\log(ab)=\\log a+\\log b$"}, {"id": "c", "text": "$\\log(ab)=\\log a\\cdot\\log b$"}, {"id": "d", "text": "$\\log\\dfrac ab=\\dfrac{\\log a}{\\log b}$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "El logaritmo de un producto es la suma de logaritmos. No hay propiedad para la suma."
    },
    {
      "id": "m04l06-x5", "kind": "numeric", "difficulty": 3, "skill_ids": ["exp_log_equations"],
      "prompt_md": "Resuelve $\\log_3(x-1)+\\log_3(x+1)=1$.",
      "key": {"value": 2, "tolerance": 0},
      "explanation_md": "$\\log_3(x^2-1)=1$ → $x^2-1=3$ → $x=\\pm2$; $x=-2$ da argumentos negativos: solo $x=2$."
    }
  ]
}
