      "prompt_md": "Resuelve el sistema $\\begin{cases}x+4\\ge1\\\\ 2x-3<x\\end{cases}$",
      "choices": [{"id": "a", "text": "$[-3,3)$"}, {"id": "b", "text": "$(-3,3]$"}, {"id": "c", "text": "$[-3,+\\infty)$"}, {"id": "d", "text": "No tiene solución"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "Primera: $x\\ge-3$. Segunda: $x<3$. Intersección: $[-3,3)$."
