    {
      "id": "m01l05-x1", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["intervals"],
      "prompt_md": "¿Qué intervalo corresponde a $-3<x\\le2$?",
      "choices": [{"id": "a", "text": "$[-3,2]$"}, {"id": "b", "text": "$(-3,2]$"}, {"id": "c", "text": "$[-3,2)$"}, {"id": "d", "text": "$(-3,2)$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "$-3$ no está incluido (paréntesis) y $2$ sí (corchete)."
    },
    {
      "id": "m01l05-x2", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["linear_inequalities"],
      "prompt_md": "Resuelve $7-2x>1$.",
      "choices": [{"id": "a", "text": "$x>3$"}, {"id": "b", "text": "$x<3$"}, {"id": "c", "text": "$x>-3$"}, {"id": "d", "text": "$x<-3$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "$-2x>-6$; al dividir entre $-2$ se invierte: $x<3$."
    },
    {
      "id": "m01l05-x3", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["intervals"],
      "prompt_md": "Calcula $(-1,5]\\cap[2,8)$.",
      "choices": [{"id": "a", "text": "$[2,5]$"}, {"id": "b", "text": "$(-1,8)$"}, {"id": "c", "text": "$(2,5)$"}, {"id": "d", "text": "$[2,5)$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "Los números comunes van de 2 (incluido en el segundo) a 5 (incluido en el primero)."
    },
    {
      "id": "m01l05-x4", "kind": "numeric", "difficulty": 2, "skill_ids": ["linear_inequalities"],
      "prompt_md": "¿Cuál es el **mayor número entero** que cumple $3(x-2)<x+5$?",
      "key": {"value": 5, "tolerance": 0},
      "explanation_md": "$3x-6<x+5$ → $2x<11$ → $x<5{,}5$. El mayor entero es 5."
    },
