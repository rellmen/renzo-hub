      "prompt_md": "¿Cuál de estas afirmaciones es correcta para matrices cuadradas $A$ y $B$ del mismo orden?",
      "choices": [{"id": "a", "text": "Siempre $AB=BA$"}, {"id": "b", "text": "En general $AB\\neq BA$"}, {"id": "c", "text": "Si $AB=O$, entonces $A=O$ o $B=O$"}, {"id": "d", "text": "$(AB)^t=A^tB^t$"}],
