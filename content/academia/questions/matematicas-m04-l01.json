  "questions": [
    {
      "id": "m04l01-x1", "kind": "numeric", "difficulty": 1, "skill_ids": ["linear_function"],
      "prompt_md": "Calcula la pendiente de la recta que pasa por $(-1,4)$ y $(3,-4)$.",
      "key": {"value": -2, "tolerance": 0},
      "explanation_md": "$m=\\dfrac{-4-4}{3-(-1)}=\\dfrac{-8}{4}=-2$."
    },
    {
      "id": "m04l01-x2", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["linear_function"],
      "prompt_md": "¿Cuál es la ecuación de la recta de pendiente 3 que pasa por $(2,5)$?",
      "choices": [{"id": "a", "text": "$y=3x+5$"}, {"id": "b", "text": "$y=3x-1$"}, {"id": "c", "text": "$y=3x+11$"}, {"id": "d", "text": "$y=2x+3$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "$y-5=3(x-2)$ → $y=3x-1$. Comprobación: $3\\cdot2-1=5$."
    },
    {
      "id": "m04l01-x3", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["quadratic_function"],
      "prompt_md": "¿Cuál es el vértice de $f(x)=x^2-6x+5$?",
      "choices": [{"id": "a", "text": "$(3,-4)$"}, {"id": "b", "text": "$(-3,32)$"}, {"id": "c", "text": "$(3,5)$"}, {"id": "d", "text": "$(6,5)$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "$x_v=-\\dfrac{-6}{2}=3$; $f(3)=9-18+5=-4$."
    },
    {
      "id": "m04l01-x4", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["quadratic_function"],
      "prompt_md": "La parábola $y=-2x^2+8x-3$…",
      "choices": [{"id": "a", "text": "abre hacia arriba y tiene un mínimo en $x=2$"}, {"id": "b", "text": "abre hacia abajo y tiene un máximo en $x=2$"}, {"id": "c", "text": "abre hacia abajo y tiene un máximo en $x=-2$"}, {"id": "d", "text": "abre hacia arriba y tiene un mínimo en $x=-2$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "$a=-2<0$: abre hacia abajo. $x_v=-\\dfrac{8}{2(-2)}=2$."
    },
    {
      "id": "m04l01-x5", "kind": "numeric", "difficulty": 3, "skill_ids": ["linear_function", "cartesian_plane"],
      "prompt_md": "Las rectas $y=2x+1$ e $y=-x+7$ se cortan en un punto. ¿Cuál es su coordenada $y$?",
      "hint_md": "Iguala las dos expresiones para encontrar $x$.",
      "key": {"value": 5, "tolerance": 0},
      "explanation_md": "$2x+1=-x+7$ → $3x=6$ → $x=2$; $y=2\\cdot2+1=5$. Punto $(2,5)$."
    }
