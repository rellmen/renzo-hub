  "questions": [
    {
      "id": "m06l01-x1", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["vectors_basic"],
      "prompt_md": "Si $A(2,5,-1)$ y $B(4,1,3)$, el vector $\\vec{AB}$ es:",
      "choices": [{"id": "a", "text": "$(-2,4,-4)$"}, {"id": "b", "text": "$(2,-4,4)$"}, {"id": "c", "text": "$(6,6,2)$"}, {"id": "d", "text": "$(2,-4,2)$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "Extremo menos origen: $(4-2,\\;1-5,\\;3-(-1))=(2,-4,4)$."
    },
    {
      "id": "m06l01-x2", "kind": "numeric", "difficulty": 1, "skill_ids": ["vectors_basic"],
      "prompt_md": "Calcula el módulo del vector $(2,-3,6)$.",
      "key": {"value": 7, "tolerance": 0},
      "explanation_md": "$\\sqrt{4+9+36}=\\sqrt{49}=7$."
    },
    {
      "id": "m06l01-x3", "kind": "numeric", "difficulty": 2, "skill_ids": ["dot_product"],
      "prompt_md": "Calcula $\\vec u\\cdot\\vec v$ con $\\vec u=(3,-1,2)$ y $\\vec v=(-2,4,5)$.",
      "key": {"value": 0, "tolerance": 0},
      "explanation_md": "$-6-4+10=0$. Además, esto indica que son perpendiculares."
    },
    {
      "id": "m06l01-x4", "kind": "numeric", "difficulty": 2, "skill_ids": ["dot_product"],
      "prompt_md": "Halla $k$ para que $(k,2,-1)$ y $(3,k,4)$ sean perpendiculares.",
      "hint_md": "Iguala el producto escalar a cero.",
      "key": {"value": 0.8, "tolerance": 0.0001},
      "explanation_md": "$3k+2k-4=0$ → $5k=4$ → $k=\\dfrac{4}{5}=0{,}8$."
    },
    {
      "id": "m06l01-x5", "kind": "multiple_choice", "difficulty": 3, "skill_ids": ["dot_product", "vectors_basic"],
      "prompt_md": "¿Qué ángulo forman $\\vec u=(1,0,1)$ y $\\vec v=(0,1,1)$?",
      "choices": [{"id": "a", "text": "$30^\\circ$"}, {"id": "b", "text": "$45^\\circ$"}, {"id": "c", "text": "$60^\\circ$"}, {"id": "d", "text": "$90^\\circ$"}],
      "key": {"correct_choice_id": "c"},
      "explanation_md": "$\\vec u\\cdot\\vec v=1$, $|\\vec u|=|\\vec v|=\\sqrt2$; $\\cos\\alpha=\\dfrac{1}{2}$ → $\\alpha=60^\\circ$."
    }
  ]
