{
  "lesson_id": "matematicas-m02-l03",
  "questions": [
    {
      "id": "m02l03-x1", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["algebraic_fractions"],
      "prompt_md": "Simplifica $\\dfrac{x^2-25}{x^2-5x}$ (para los $x$ permitidos).",
      "choices": [{"id": "a", "text": "$\\dfrac{x+5}{x}$"}, {"id": "b", "text": "$\\dfrac{-25}{-5x}$"}, {"id": "c", "text": "$x+5$"}, {"id": "d", "text": "$\\dfrac{x-5}{x}$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "$\\dfrac{(x-5)(x+5)}{x(x-5)}=\\dfrac{x+5}{x}$, con $x\\neq0,5$."
    },
    {
      "id": "m02l03-x2", "kind": "multiple_choice", "difficulty": 1, "skill_ids": ["domain_restrictions"],
      "prompt_md": "¿Para qué valores **no** está definida $\\dfrac{3}{x^2-4x+4}$?",
      "choices": [{"id": "a", "text": "$x=4$"}, {"id": "b", "text": "$x=2$ y $x=-2$"}, {"id": "c", "text": "$x=2$"}, {"id": "d", "text": "Está definida para todo $x$"}],
      "key": {"correct_choice_id": "c"},
      "explanation_md": "$x^2-4x+4=(x-2)^2$ se anula solo en $x=2$."
    },
    {
      "id": "m02l03-x3", "kind": "numeric", "difficulty": 2, "skill_ids": ["algebraic_fractions"],
      "prompt_md": "Calcula el valor de $\\dfrac{x^2-4}{x-2}$ para $x=5$.",
      "key": {"value": 7, "tolerance": 0},
      "explanation_md": "Simplificada es $x+2$ (para $x\\neq2$): $5+2=7$. Directamente: $\\dfrac{21}{3}=7$."
    },
    {
      "id": "m02l03-x4", "kind": "multiple_choice", "difficulty": 2, "skill_ids": ["algebraic_fractions"],
      "prompt_md": "Calcula $\\dfrac{2}{x}+\\dfrac{3}{2x}$.",
      "choices": [{"id": "a", "text": "$\\dfrac{5}{3x}$"}, {"id": "b", "text": "$\\dfrac{7}{2x}$"}, {"id": "c", "text": "$\\dfrac{5}{2x}$"}, {"id": "d", "text": "$\\dfrac{6}{2x^2}$"}],
      "key": {"correct_choice_id": "b"},
      "explanation_md": "mcm $2x$: $\\dfrac{4}{2x}+\\dfrac{3}{2x}=\\dfrac{7}{2x}$."
    },
    {
      "id": "m02l03-x5", "kind": "multiple_choice", "difficulty": 3, "skill_ids": ["algebraic_fractions", "domain_restrictions"],
      "prompt_md": "Simplifica $\\dfrac{1}{x-3}-\\dfrac{6}{x^2-9}$.",
      "choices": [{"id": "a", "text": "$\\dfrac{1}{x+3}$"}, {"id": "b", "text": "$\\dfrac{-5}{x^2-9}$"}, {"id": "c", "text": "$\\dfrac{x-9}{x^2-9}$"}, {"id": "d", "text": "$\\dfrac{1}{x-3}$"}],
      "key": {"correct_choice_id": "a"},
      "explanation_md": "$\\dfrac{(x+3)-6}{(x-3)(x+3)}=\\dfrac{x-3}{(x-3)(x+3)}=\\dfrac{1}{x+3}$, con $x\\neq\\pm3$."
    }
  ]
}
