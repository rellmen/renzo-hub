export type Band={min:number;id:"dominio"|"practica"|"rescate";label:string};
export type CatalogLesson={id:string;title:string;topic_scope:string;level:string;status:"planned"|"draft"|"reviewed"|"ready"|"published";
  estimated_minutes:number;prerequisites:string[];has_content:boolean;pilot:boolean;meets_standard:boolean;gaps:string[];skill_ids?:string[]};
export type CatalogModule={id:string;title:string;level:string;lessons:CatalogLesson[]};
export type CatalogCourse={slug:string;title:string;role:string;role_label:string;exam_profile:string;models_url:string;official_syllabus_url:string;modules:CatalogModule[]};
export type Catalog={schema_version:string;exam_dates:{general:string;especifica:string;source:string;note:string};
  elective:{chosen:string;alternative:string;confirmed:boolean};courses:CatalogCourse[];
  stats:{by_status:Record<string,number>;lessons_total:number;meets_standard:number;questions_total:number;exit_questions:number;bank_questions:number;
    courses:Record<string,{total:number;with_content:number;meets_standard:number;by_status:Record<string,number>}>}};
export type FlatLesson=CatalogLesson&{course:string;course_title:string;module:string;module_title:string;role:string};
export type ProgressRow={lesson_id:string;status:"in_progress"|"completed"|"mastered";last_section?:string|null;draft?:Record<string,unknown>;
  revision:number;best_exit_pct?:number|null;last_result?:Record<string,unknown>|null;completed_at?:string|null;opened_at?:string;updated_at?:string};
export type ReviewRow={lesson_id:string;step:number;due_on:string;last_pct?:number|null};
export type AttemptRow={question_id:string;lesson_id:string;course:string;context:string;is_correct:boolean;skill_ids:string[];created_at:string;answer?:unknown;session_id?:string|null};
export type Prefs={weekly_minutes:number;session_minutes:number;elective:"economia"|"fisica";show_drafts:boolean;revision:number};
export type SkillStat={skill:string;course:string;n:number;correct:number;pct:number;band?:string;last:string};
export type PlanLesson={type:"lesson";course:string;lesson:FlatLesson;inProgress:boolean;missingPrereqs:string[];priority:number};
export type ExamSection={label:string;available?:number;choose?:number;points_each?:number;count?:number;points?:number;[k:string]:unknown};
export type ExamProfile={id:string;course:string;scale:number;sections:ExamSection[];official_url:string;penalties?:Record<string,number>;grading?:string;note?:string};
