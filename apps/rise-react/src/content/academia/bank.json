,"text":"adverbio"},{"id":"c","text":"verbo"},{"id":"d","text":"preposición"}]},{"id":"cas-006","lesson_id":"castellano-c03-l01","course":"castellano","kind":"multiple_choice","difficulty":1,"skill_ids":["syntax"],"prompt_md":"En «María envió el informe a Pablo», ¿qué es «el informe»?","role":"bank","choices":[{"id":"a","text":"sujeto"},{"id":"b","text":"complemento directo"},{"id":"c","text":"complemento indirecto"},{"id":"d","text":"atributo"}]},{"id":"cas-007","lesson_id":"castellano-c03-l01","course":"castellano","kind":"multiple_choice","difficulty":1,"skill_ids":["syntax"],"prompt_md":"Sujeto de «Llegaron ayer los camiones».","role":"bank","choices":[{"id":"a","text":"ayer"},{"id":"b","text":"Llegaron"},{"id":"c","text":"los camiones"},{"id":"d","text":"no tiene sujeto"}]},{"id":"cas-008","lesson_id":"castellano-c06-l01","course":"castellano","kind":"essay","difficulty":2,"skill_ids":["written_expression"],"prompt_md":"Escribe 50–80 palabras: una ventaja y una dificultad del estudio online.","role":"bank","words":[50,80],"rubric":["Responde a ventaja y dificultad","50–80 palabras","Coherencia y cohesión","Corrección ortográfica y sintáctica"],"model_md":"Estudiar a distancia permite organizar mejor el tiempo... Sin embargo, exige constancia..."},{"id":"com-001","lesson_id":"comentario-t00-l01","course":"comentario","kind":"multiple_choice","difficulty":1,"skill_ids":["thesis"],"prompt_md":"¿Cuál es la tesis en el texto «La tecnología acelera tareas; sin formación, los errores persisten. Por eso, cada implantación tecnológica debería incluir capacitación»?","role":"bank","choices":[{"id":"a","text":"La tecnología siempre falla"},{"id":"b","text":"La formación debe acompañar la tecnología"},{"id":"c","text":"La velocidad importa más que la seguridad"},{"id":"d","text":"No deben usarse máquinas"}]},{"id":"com-002","lesson_id":"comentario-t00-l01","course":"comentario","kind":"multiple_choice","difficulty":1,"skill_ids":["topic_vs_subject"],"prompt_md":"En un comentario, «tecnología» por sí sola es normalmente…","role":"bank","choices":[{"id":"a","text":"asunto general"},{"id":"b","text":"argumento completo"},{"id":"c","text":"conclusión"},{"id":"d","text":"dato cuantitativo"}]},{"id":"com-003","lesson_id":"comentario-t03-l01","course":"comentario","kind":"multiple_choice","difficulty":1,"skill_ids":["summary"],"prompt_md":"Un resumen objetivo debe…","role":"bank","choices":[{"id":"a","text":"añadir la opinión personal"},{"id":"b","text":"copiar frases largas"},{"id":"c","text":"seleccionar ideas y parafrasearlas"},{"id":"d","text":"incluir ejemplos nuevos no presentes"}]},{"id":"com-004","lesson_id":"comentario-t03-l01","course":"comentario","kind":"multiple_choice","difficulty":1,"skill_ids":["summary"],"prompt_md":"¿Qué conducta es un error en un resumen?","role":"bank","choices":[{"id":"a","text":"emplear palabras propias"},{"id":"b","text":"reducir ejemplos"},{"id":"c","text":"cambiar una condición necesaria en suficiente"},{"id":"d","text":"identificar idea central"}]},{"id":"com-005","lesson_id":"comentario-t05-l01","course":"comentario","kind":"multiple_choice","difficulty":1,"skill_ids":["argumentation"],"prompt_md":"¿Qué es un contraargumento?","role":"bank","choices":[{"id":"a","text":"una repetición de tesis"},{"id":"b","text":"objeción razonable que se analiza"},{"id":"c","text":"una errata"},{"id":"d","text":"un párrafo descriptivo sin relación"}]},{"id":"com-006","lesson_id":"comentario-t05-l01","course":"comentario","kind":"essay","difficulty":3,"skill_ids":["argumentation"],"prompt_md":"Redacta 150–200 palabras sobre si las empresas deberían financiar formación continua. Incluye un contraargumento.","role":"bank","words":[150,200],"rubric":["Tesis definida","Argumentos razonados y contraargumento","Estructura y coherencia","Norma gramatical y registro"],"model_md":"Las empresas deben valorar la formación... aunque implica coste... sus beneficios..."},{"id":"com-007","lesson_id":"comentario-t03-l01","course":"comentario","kind":"essay","difficulty":2,"skill_ids":["summary"],"prompt_md":"Resume sin opinar (25–35 palabras): «Los sensores aportan datos del consumo de edificios. Pero si no se analizan, las cifras no reducen el gasto ni mejoran el servicio».","role":"bank","words":[25,35],"rubric":["Preserva las dos ideas","Reformulación propia","Sin opinión","25–35 palabras"],"model_md":"Los sensores ayudan a conocer el gasto, pero solo un análisis que conduzca a decisiones permite obtener mejoras reales."},{"id":"eng-001","lesson_id":"ingles-e00-l01","course":"ingles","kind":"multiple_choice","difficulty":1,"skill_ids":["present_simple"],"prompt_md":"Complete: «He ___ inventory every day».","role":"bank","choices":[{"id":"a","text":"check"},{"id":"b","text":"checks"},{"id":"c","text":"checking"},{"id":"d","text":"checked"}]},{"id":"eng-002","lesson_id":"ingles-e00-l01","course":"ingles","kind":"multiple_choice","difficulty":1,"skill_ids":["auxiliaries"],"prompt_md":"Choose the correct question.","role":"bank","choices":[{"id":"a","text":"Does she works on Monday?"},{"id":"b","text":"Do she work on Monday?"},{"id":"c","text":"Does she work on Monday?"},{"id":"d","text":"She does work on Monday?"}]},{"id":"eng-003","lesson_id":"ingles-e01-l01","course":"ingles","kind":"multiple_choice","difficulty":1,"skill_ids":["present_continuous"],"prompt_md":"Complete: «Right now, I ___ English».","role":"bank","choices":[{"id":"a","text":"study"},{"id":"b","text":"studies"},{"id":"c","text":"am studying"},{"id":"d","text":"studied"}]},{"id":"eng-004","lesson_id":"ingles-e01-l01","course":"ingles","kind":"multiple_choice","difficulty":1,"skill_ids":["present_simple"],"prompt_md":"Complete: «We usually ___ at five».","role":"bank","choices":[{"id":"a","text":"finish"},{"id":"b","text":"are finishing"},{"id":"c","text":"finishes"},{"id":"d","text":"finished"}]},{"id":"eng-005","lesson_id":"ingles-e03-l01","course":"ingles","kind":"multiple_choice","difficulty":1,"skill_ids":["reading_detail"],"prompt_md":"Text: «An app was introduced alongside paper forms, causing duplicate work. Later the forms were removed». Why remove paper?","role":"bank","choices":[{"id":"a","text":"To avoid duplicated tasks"},{"id":"b","text":"To increase paperwork"},{"id":"c","text":"Because computers failed"},{"id":"d","text":"To close the company"}]},{"id":"eng-006","lesson_id":"ingles-e03-l01","course":"ingles","kind":"multiple_choice","difficulty":1,"skill_ids":["reading_inference"],"prompt_md":"Text: «The app reduced errors, but staff still needed training». Did the app eliminate training?","role":"bank","choices":[{"id":"a","text":"Yes, immediately"},{"id":"b","text":"No, employees still needed it"},{"id":"c","text":"Only managers needed it"},{"id":"d","text":"The text gives no information"}]},{"id":"eng-007","lesson_id":"ingles-e05-l01","course":"ingles","kind":"multiple_choice","difficulty":1,"skill_ids":["short_answer"],"prompt_md":"Which opener answers «Why was training useful?» directly?","role":"bank","choices":[{"id":"a","text":"In my personal life I like learning"},{"id":"b","text":"The world is changing a lot"},{"id":"c","text":"Training was useful because staff faced unusual cases"},{"id":"d","text":"This is a very complicated question"}]},{"id":"eng-008","lesson_id":"ingles-e05-l01","course":"ingles","kind":"essay","difficulty":2,"skill_ids":["short_answer"],"prompt_md":"In English, write 40–60 words: «Why can a digital tool still require employee training?»","role":"bank","words":[40,60],"rubric":["Answers question","40–60 English words","Coherent reason and example","Grammar, lexis, spelling"],"model_md":"A digital tool may speed up routine tasks, but unusual cases need human judgement. Training helps people understand errors, follow safety procedures and use information responsibly. Therefore, introducing new software is not enough unless employees also learn how to use it correctly."},{"id":"eco-001","lesson_id":"economia-b00-l01","course":"economia","kin