{
  "name": "renzo-hub",
  "private": true,
  "description": "RISE HUB (antes Renzo HUB) · plataforma personal privada (no forma parte de Nodalys)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "for f in *.js api/*.js; do node --check \"$f\" || exit 1; done",
    "dev": "node tools/dev-server.mjs 4173",
    "test:smoke": "node tests/e2e/smoke.mjs",
    "test:e2e": "node tests/e2e/authenticated.mjs",
    "build:selflearn": "esbuild microapps/selflearn/fsrs-entry.js --bundle --format=esm --platform=browser --target=es2020 --outfile=microapps/selflearn/fsrs-bundle.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "^0.28.2",
    "playwright": "1.64.0"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2"
  }
}
